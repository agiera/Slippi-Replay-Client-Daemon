{
  "name": "slippi-replay-client-daemon",
  "version": "0.2.0",
  "description": "Cross-platform tray daemon that watches a directory and uploads new Slippi replay files.",
  "homepage": "https://github.com/agiera/slippi-replay-client-daemon",
  "main": "main.js",
  "author": {
    "name": "Aaron Giera",
    "email": "aaron.giera@gmail.com"
  },
  "engines": {
    "node": ">=22.22.0",
    "npm": ">=11"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "build": "electron-builder",
    "build:linux": "electron-builder --linux AppImage",
    "build:windows": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.agiera.slippi-replay-client-daemon",
    "productName": "Slippi Replay Sync",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "src/**/*",
      "resources/**/*",
      ".env.example"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "Aaron Giera <aaron.giera@gmail.com>"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    }
  },
  "dependencies": {
    "axios": "^1.21.0",
    "chokidar": "^6.0.0",
    "dotenv": "^18.0.9",
    "form-data": "^4.0.6"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  }
}
